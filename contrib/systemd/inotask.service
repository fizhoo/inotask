[Unit]
Description=inotask filesystem event runner
After=local-fs.target

[Service]
Type=exec
Environment=INOTASK_LOG_LEVEL=info
ExecStart=/usr/local/bin/inotask /etc/inotask/inotaskd.cfg
Restart=on-failure
RestartSec=2s
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=inotask

[Install]
WantedBy=multi-user.target
